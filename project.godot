config_version=5

[application]
config/name="Kyoto & the Midnight Signal"
run/main_scene="res://scenes/exploration.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A wordless, painted storybook adventure. Opening prototype."

[display]
window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.047, 0.09, 1)

[audio]
driver/enable_input=false
